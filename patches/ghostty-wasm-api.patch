+pub fn renderStateGetViewport(
+    handle: ?*anyopaque,
+    buf: ?[*]GhosttyCell,
+    buf_len: usize,
+) callconv(lib.calling_conv) c_int {
+    const wrapper = terminalFromHandle(handle) orelse return -1;
+    const cols: usize = @intCast(renderStateGetCols(handle));
+    const rows: usize = @intCast(renderStateGetRows(handle));
+    const total = cols * rows;
+    if (buf == null or buf_len < total) return -1;
+
+    const colors = getCurrentColors(wrapper);
+    const out = buf.?[0..total];
+    for (0..rows) |y| {
+        for (0..cols) |x| {
+            const i = y * cols + x;
+            var ref: grid_ref_c.CGridRef = .{};
+            if (terminal_c.grid_ref(
+                wrapper.terminal,
+                pointpkg.Point.cval(.{
+                    .active = .{ .x = @intCast(x), .y = @intCast(y) },
+                }),
+                &ref,
+            ) != .success) {
+                out[i] = emptyCell(colors);
+                continue;
+            }
+
+            out[i] = packCell(wrapper, ref, colors);
+        }
+    }
+
+    return @intCast(total);
+}
