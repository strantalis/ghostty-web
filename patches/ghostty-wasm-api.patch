+
+pub fn terminal_get_kitty_graphics_placements_in_viewport(
+    handle: ?*anyopaque,
+    viewport_top: c_int,
+    buf: ?[*]PackedKittyPlacement,
+    buf_len: usize,
+) callconv(lib.calling_conv) c_int {
+    const wrapper = terminalFromHandle(handle) orelse return -1;
+
+    var graphics: terminal_c.KittyGraphics = undefined;
+    if (terminal_c.get(wrapper.terminal, .kitty_graphics, @ptrCast(&graphics)) != .success) return 0;
+
+    const viewport_top_u32: u32 = if (viewport_top <= 0) 0 else @intCast(viewport_top);
+    const viewport_origin_y = getViewportScreenOriginY(wrapper, viewport_top_u32);
+    const rows: i32 = renderStateGetRows(handle);
+    const cols: i32 = renderStateGetCols(handle);
+
+    var written: usize = 0;
+
+    var it: kitty_graphics_c.PlacementIterator = null;
+    if (kitty_graphics_c.placement_iterator_new(null, &it) != .success) return -1;
+    defer kitty_graphics_c.placement_iterator_free(it);
+    if (kitty_graphics_c.get(graphics, .placement_iterator, @ptrCast(&it)) != .success) return -1;
+
+    while (kitty_graphics_c.placement_iterator_next(it)) {
+        var is_virtual = false;
+        _ = kitty_graphics_c.placement_get(it, .is_virtual, @ptrCast(&is_virtual));
+        if (is_virtual) continue;
+
+        const entry = buildPinnedPlacement(wrapper, it, viewport_origin_y, rows, cols) orelse continue;
+        if (buf) |out_buf| {
+            if (written >= buf_len) return -1;
+            out_buf[written] = entry;
+        }
+        written += 1;
+    }
+
+    appendVirtualPlacements(wrapper, graphics, viewport_top_u32, viewport_origin_y, rows, cols, buf, buf_len, &written) catch return -1;
+
+    return @intCast(written);
+}
