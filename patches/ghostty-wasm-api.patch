+fn snapshotDirtyRows(wrapper: *BrowserTerminal) Result {
+    var rows: size.CellCountInt = 0;
+    if (terminal_c.get(wrapper.terminal, .rows, @ptrCast(&rows)) != .success) return .invalid_value;
+
+    wrapper.row_dirty.resize(wrapper.alloc, @intCast(rows)) catch return .out_of_memory;
+    @memset(wrapper.row_dirty.items, 0);
+
+    var it: render_c.RowIterator = null;
+    if (render_c.row_iterator_new(null, &it) != .success) return .out_of_memory;
+    defer render_c.row_iterator_free(it);
+    if (render_c.get(wrapper.render_state, .row_iterator, @ptrCast(&it)) != .success) return .invalid_value;
+
+    var index: usize = 0;
+    while (render_c.row_iterator_next(it)) : (index += 1) {
+        var dirty = false;
+        if (render_c.row_get(it, .dirty, @ptrCast(&dirty)) != .success) return .invalid_value;
+        if (index < wrapper.row_dirty.items.len) {
+            wrapper.row_dirty.items[index] = if (dirty) 1 else 0;
+        }
+    }
+
+    return .success;
+}
+
+fn getCurrentColors(wrapper: *BrowserTerminal) CurrentColors {
+    var palette_c: colorpkg.PaletteC = undefined;
+    var bg_c: colorpkg.RGB.C = DefaultBg.cval();
+    var fg_c: colorpkg.RGB.C = DefaultFg.cval();
+    var cursor_c: colorpkg.RGB.C = undefined;
+    const has_bg = terminal_c.get(wrapper.terminal, .color_background, @ptrCast(&bg_c)) == .success or
+        terminal_c.get(wrapper.terminal, .color_background_default, @ptrCast(&bg_c)) == .success;
+    const has_fg = terminal_c.get(wrapper.terminal, .color_foreground, @ptrCast(&fg_c)) == .success or
+        terminal_c.get(wrapper.terminal, .color_foreground_default, @ptrCast(&fg_c)) == .success;
+    const has_cursor = terminal_c.get(wrapper.terminal, .color_cursor, @ptrCast(&cursor_c)) == .success or
+        terminal_c.get(wrapper.terminal, .color_cursor_default, @ptrCast(&cursor_c)) == .success;
+
+    if (terminal_c.get(wrapper.terminal, .color_palette, @ptrCast(&palette_c)) != .success) {
+        palette_c = colorpkg.paletteCval(&colorpkg.default);
+    }
+
+    return .{
+        .background = if (has_bg) .fromC(bg_c) else DefaultBg,
+        .foreground = if (has_fg) .fromC(fg_c) else DefaultFg,
+        .cursor = if (has_cursor) .fromC(cursor_c) else null,
+        .palette = colorpkg.paletteZval(&palette_c),
+    };
+}
+
+fn emptyCell(colors: CurrentColors) GhosttyCell {
+    return .{
+        .codepoint = 0,
+        .fg_r = colors.foreground.r,
+        .fg_g = colors.foreground.g,
+        .fg_b = colors.foreground.b,
+        .bg_r = colors.background.r,
+        .bg_g = colors.background.g,
+        .bg_b = colors.background.b,
+        .flags = 0,
+        .width = 1,
+        .hyperlink_id = 0,
+        .grapheme_len = 0,
+    };
+}
+
+fn packCell(_: *BrowserTerminal, ref: grid_ref_c.CGridRef, colors: CurrentColors) GhosttyCell {
+    const pin = ref.toPin() orelse return emptyCell(colors);
+    const rac = pin.rowAndCell();
+    const cell = rac.cell.*;
+
+    var style: stylepkg.Style = .{};
+    if (cell.style_id != stylepkg.default_id) {
+        style = pin.node.data.styles.get(pin.node.data.memory, cell.style_id).*;
+    }
+
+    const fg = if (style.fg_color == .none)
+        colors.foreground
+    else
+        style.fg(.{ .default = colors.foreground, .palette = &colors.palette });
+    const bg = style.bg(rac.cell, &colors.palette) orelse colors.background;
+
+    const grapheme_len: u8 = if (cell.hasGrapheme())
+        @intCast((pin.grapheme(rac.cell) orelse &[_]u21{}).len)
+    else
+        0;
+
+    return .{
+        .codepoint = if (cell.hasText()) @intCast(cell.codepoint()) else 0,
+        .fg_r = fg.r,
+        .fg_g = fg.g,
+        .fg_b = fg.b,
+        .bg_r = bg.r,
+        .bg_g = bg.g,
+        .bg_b = bg.b,
+        .flags = packFlags(style),
+        .width = switch (cell.wide) {
+            .narrow => 1,
+            .wide => 2,
+            .spacer_head, .spacer_tail => 0,
+        },
+        .hyperlink_id = if (cell.hyperlink) hashHyperlink(ref) else 0,
+        .grapheme_len = grapheme_len,
+    };
+}
+
+fn packFlags(style: stylepkg.Style) u8 {
+    var flags: u8 = 0;
+    if (style.flags.bold) flags |= 1 << 0;
+    if (style.flags.italic) flags |= 1 << 1;
+    if (style.flags.underline != .none) flags |= 1 << 2;
+    if (style.flags.strikethrough) flags |= 1 << 3;
+    if (style.flags.inverse) flags |= 1 << 4;
+    if (style.flags.invisible) flags |= 1 << 5;
+    if (style.flags.blink) flags |= 1 << 6;
+    if (style.flags.faint) flags |= 1 << 7;
+    return flags;
+}
+
+fn writeGrapheme(ref: grid_ref_c.CGridRef, buf: ?[*]u32, buf_len: usize) c_int {
+    const pin = ref.toPin() orelse return -1;
+    const cell = pin.rowAndCell().cell;
+    if (!cell.hasText()) return 0;
+
+    const extra = if (cell.hasGrapheme()) pin.grapheme(cell) orelse &[_]u21{} else &[_]u21{};
+    const total = 1 + extra.len;
+    if (buf == null or buf_len < total) return -1;
+
+    const out = buf.?[0..total];
+    out[0] = @intCast(cell.codepoint());
+    for (extra, 1..) |cp, i| out[i] = cp;
+    return @intCast(total);
+}
+
+fn hashHyperlink(ref: grid_ref_c.CGridRef) u16 {
+    const pin = ref.toPin() orelse return 0;
+    const rac = pin.rowAndCell();
+    if (!rac.cell.hyperlink) return 0;
+
+    const link_id = pin.node.data.lookupHyperlink(rac.cell) orelse return 0;
+    const entry = pin.node.data.hyperlink_set.get(pin.node.data.memory, link_id);
+    const uri = entry.uri.slice(pin.node.data.memory);
+
+    var hash: u32 = 2166136261;
+    for (uri) |byte| {
+        hash ^= byte;
+        hash *%= 16777619;
+    }
+
+    const folded: u16 = @truncate(hash ^ (hash >> 16));
+    return if (folded == 0) 1 else folded;
+}
+
+fn readQueuedBytes(
+    queue: *std.ArrayList(u8),
+    buf: [*]u8,
+    buf_len: usize,
+    require_full_buffer: bool,
+) c_int {
+    if (queue.items.len == 0) return 0;
+    if (require_full_buffer and buf_len < queue.items.len) return -1;
+
+    const n = @min(buf_len, queue.items.len);
+    @memcpy(buf[0..n], queue.items[0..n]);
+
+    if (n == queue.items.len) {
+        queue.clearRetainingCapacity();
+    } else {
+        std.mem.copyForwards(u8, queue.items[0 .. queue.items.len - n], queue.items[n..]);
+        queue.items.len -= n;
+    }
+
+    return @intCast(n);
+}
+
+fn writeHyperlinkForPoint(
+    handle: ?*anyopaque,
+    pt: pointpkg.Point,
+    buf: ?[*]u8,
+    buf_len: usize,
+) c_int {
+    const wrapper = terminalFromHandle(handle) orelse return -1;
+    var ref: grid_ref_c.CGridRef = .{};
+    if (terminal_c.grid_ref(wrapper.terminal, pointpkg.Point.cval(pt), &ref) != .success) return -1;
+
+    var needed: usize = 0;
+    const size_result = grid_ref_c.grid_ref_hyperlink_uri(&ref, null, 0, &needed);
+    if (size_result == .success and needed == 0) return 0;
+    if (size_result != .out_of_space and size_result != .success) return -1;
+    if (buf == null or buf_len < needed) return -1;
+
+    var written: usize = 0;
+    if (grid_ref_c.grid_ref_hyperlink_uri(&ref, buf, buf_len, &written) != .success) return -1;
+    return @intCast(written);
+}
+
+fn getViewportScreenOriginY(wrapper: *BrowserTerminal, viewport_top: u32) i32 {
+    var scrollback_rows: usize = 0;
+    if (terminal_c.get(wrapper.terminal, .scrollback_rows, @ptrCast(&scrollback_rows)) != .success) {
+        return 0;
+    }
+    const top = @min(scrollback_rows, viewport_top);
+    return @intCast(scrollback_rows - top);
+}
+
+fn buildPinnedPlacement(
+    wrapper: *BrowserTerminal,
+    iter: kitty_graphics_c.PlacementIterator,
+    viewport_origin_y: i32,
+    rows: i32,
+    cols: i32,
+) ?PackedKittyPlacement {
+    var image_id: u32 = 0;
+    var placement_id: u32 = 0;
+    var z: i32 = 0;
+    var x_offset_u: u32 = 0;
+    var y_offset_u: u32 = 0;
+    var source_x: u32 = 0;
+    var source_y: u32 = 0;
+    var source_width: u32 = 0;
+    var source_height: u32 = 0;
+
+    _ = kitty_graphics_c.placement_get(iter, .image_id, @ptrCast(&image_id));
+    _ = kitty_graphics_c.placement_get(iter, .placement_id, @ptrCast(&placement_id));
+    _ = kitty_graphics_c.placement_get(iter, .z, @ptrCast(&z));
+    _ = kitty_graphics_c.placement_get(iter, .x_offset, @ptrCast(&x_offset_u));
+    _ = kitty_graphics_c.placement_get(iter, .y_offset, @ptrCast(&y_offset_u));
+    _ = kitty_graphics_c.placement_get(iter, .source_x, @ptrCast(&source_x));
+    _ = kitty_graphics_c.placement_get(iter, .source_y, @ptrCast(&source_y));
+    _ = kitty_graphics_c.placement_get(iter, .source_width, @ptrCast(&source_width));
+    _ = kitty_graphics_c.placement_get(iter, .source_height, @ptrCast(&source_height));
+
+    const image = kitty_graphics_c.image_get_handle(getGraphics(wrapper) orelse return null, image_id) orelse return null;
+
+    var rect: @import("selection.zig").CSelection = .{
+        .start = undefined,
+        .end = undefined,
+    };
+    if (kitty_graphics_c.placement_rect(iter, image, wrapper.terminal, &rect) != .success) return null;
+
+    var start: pointpkg.Coordinate = undefined;
+    var end: pointpkg.Coordinate = undefined;
+    if (terminal_c.point_from_grid_ref(wrapper.terminal, &rect.start, .screen, &start) != .success) return null;
+    if (terminal_c.point_from_grid_ref(wrapper.terminal, &rect.end, .screen, &end) != .success) return null;
+
+    if (end.y < @as(u32, @intCast(viewport_origin_y)) or start.y >= @as(u32, @intCast(viewport_origin_y + rows))) {
+        return null;
+    }
+    if (end.x < 0 or start.x >= cols) {
+        return null;
+    }
+
+    var pixel_width: u32 = 0;
+    var pixel_height: u32 = 0;
+    _ = kitty_graphics_c.placement_pixel_size(iter, image, wrapper.terminal, &pixel_width, &pixel_height);
+
+    var image_width: u32 = 0;
+    var image_height: u32 = 0;
+    var format: kitty_graphics_c.ImageFormat = .rgb;
+    var compression: kitty_graphics_c.ImageCompression = .none;
+    var data_ptr: [*]const u8 = undefined;
+    var data_len: usize = 0;
+    _ = kitty_graphics_c.image_get(image, .width, @ptrCast(&image_width));
+    _ = kitty_graphics_c.image_get(image, .height, @ptrCast(&image_height));
+    _ = kitty_graphics_c.image_get(image, .format, @ptrCast(&format));
+    _ = kitty_graphics_c.image_get(image, .compression, @ptrCast(&compression));
+    _ = kitty_graphics_c.image_get(image, .data_ptr, @ptrCast(&data_ptr));
+    _ = kitty_graphics_c.image_get(image, .data_len, @ptrCast(&data_len));
+
+    if (pixel_width == 0) pixel_width = if (source_width > 0) source_width else image_width;
+    if (pixel_height == 0) pixel_height = if (source_height > 0) source_height else image_height;
+
+    return .{
+        .image_id = image_id,
+        .placement_id = placement_id,
+        .z = z,
+        .viewport_x = start.x,
+        .viewport_y = @as(i32, @intCast(start.y)) - viewport_origin_y,
+        .x_offset = @intCast(x_offset_u),
+        .y_offset = @intCast(y_offset_u),
+        .pixel_width = pixel_width,
+        .pixel_height = pixel_height,
+        .source_x = source_x,
+        .source_y = source_y,
+        .source_width = if (source_width > 0) source_width else image_width,
+        .source_height = if (source_height > 0) source_height else image_height,
+        .image_width = image_width,
+        .image_height = image_height,
+        .format = @intCast(@intFromEnum(format)),
+        .compression = @intCast(@intFromEnum(compression)),
+        .data_ptr = @intCast(@intFromPtr(data_ptr)),
+        .data_len = @intCast(data_len),
+    };
+}
+
+fn appendVirtualPlacements(
+    wrapper: *BrowserTerminal,
+    graphics: terminal_c.KittyGraphics,
+    viewport_top: u32,
+    viewport_origin_y: i32,
+    rows: i32,
+    cols: i32,
+    buf: ?[*]PackedKittyPlacement,
+    buf_len: usize,
+    written: *usize,
+) !void {
+    const top_screen_y: u32 = @intCast(viewport_origin_y);
+    const top_ref = screenGridRef(wrapper, 0, top_screen_y) orelse return;
+
+    const bottom_screen_y = top_screen_y + @as(u32, @intCast(@max(rows - 1, 0)));
+    const limit_ref = screenGridRef(wrapper, @intCast(@max(cols - 1, 0)), bottom_screen_y);
+
+    var unicode_it = graphics_unicode.placementIterator(
+        top_ref.toPin() orelse return,
+        if (limit_ref) |v| v.toPin() else null,
+    );
+
+    const cell_width = @max(wrapper.cell_width_px, 1);
+    const cell_height = @max(wrapper.cell_height_px, 1);
+
+    while (unicode_it.next()) |placement| {
+        const image = kitty_graphics_c.image_get_handle(graphics, placement.image_id) orelse continue;
+        const rp = placement.renderPlacement(graphics, image, cell_width, cell_height) catch continue;
+
+        const top_left_ref = grid_ref_c.CGridRef.fromPin(rp.top_left);
+        var screen_pos: pointpkg.Coordinate = undefined;
+        if (terminal_c.point_from_grid_ref(wrapper.terminal, &top_left_ref, .screen, &screen_pos) != .success) continue;
+
+        const end_y = screen_pos.y + placement.height - 1;
+        const end_x = screen_pos.x + @as(i32, @intCast(placement.width)) - 1;
+        if (end_y < top_screen_y or screen_pos.y >= top_screen_y + @as(u32, @intCast(rows))) continue;
+        if (end_x < 0 or screen_pos.x >= cols) continue;
+
+        var image_width: u32 = 0;
+        var image_height: u32 = 0;
+        var format: kitty_graphics_c.ImageFormat = .rgb;
+        var compression: kitty_graphics_c.ImageCompression = .none;
+        var data_ptr: [*]const u8 = undefined;
+        var data_len: usize = 0;
+        _ = kitty_graphics_c.image_get(image, .width, @ptrCast(&image_width));
+        _ = kitty_graphics_c.image_get(image, .height, @ptrCast(&image_height));
+        _ = kitty_graphics_c.image_get(image, .format, @ptrCast(&format));
+        _ = kitty_graphics_c.image_get(image, .compression, @ptrCast(&compression));
+        _ = kitty_graphics_c.image_get(image, .data_ptr, @ptrCast(&data_ptr));
+        _ = kitty_graphics_c.image_get(image, .data_len, @ptrCast(&data_len));
+
+        const entry: PackedKittyPlacement = .{
+            .image_id = placement.image_id,
+            .placement_id = placement.placement_id,
+            .z = 0,
+            .viewport_x = screen_pos.x,
+            .viewport_y = @as(i32, @intCast(screen_pos.y)) - viewport_origin_y,
+            .x_offset = @intCast(rp.offset_x),
+            .y_offset = @intCast(rp.offset_y),
+            .pixel_width = rp.dest_width,
+            .pixel_height = rp.dest_height,
+            .source_x = rp.source_x,
+            .source_y = rp.source_y,
+            .source_width = rp.source_width,
+            .source_height = rp.source_height,
+            .image_width = image_width,
+            .image_height = image_height,
+            .format = @intCast(@intFromEnum(format)),
+            .compression = @intCast(@intFromEnum(compression)),
+            .data_ptr = @intCast(@intFromPtr(data_ptr)),
+            .data_len = @intCast(data_len),
+        };
+
+        if (buf) |out_buf| {
+            if (written.* >= buf_len) return error.OutOfMemory;
+            out_buf[written.*] = entry;
+        }
+        written.* += 1;
+    }
+
+    _ = viewport_top;
+}
+
+fn getGraphics(wrapper: *BrowserTerminal) ?terminal_c.KittyGraphics {
+    var graphics: terminal_c.KittyGraphics = undefined;
+    if (terminal_c.get(wrapper.terminal, .kitty_graphics, @ptrCast(&graphics)) != .success) return null;
+    return graphics;
+}
+
+fn screenGridRef(wrapper: *BrowserTerminal, x: size.CellCountInt, y: u32) ?grid_ref_c.CGridRef {
+    var ref: grid_ref_c.CGridRef = .{};
+    if (terminal_c.grid_ref(
+        wrapper.terminal,
+        pointpkg.Point.cval(.{ .screen = .{ .x = x, .y = y } }),
+        &ref,
+    ) != .success) return null;
+    return ref;
+}
+
+fn rgbCFromU32(value: u32) colorpkg.RGB.C {
+    return .{
+        .r = @truncate((value >> 16) & 0xFF),
+        .g = @truncate((value >> 8) & 0xFF),
+        .b = @truncate(value & 0xFF),
+    };
+}
+
+fn rgbToU32(rgb: colorpkg.RGB) u32 {
+    return (@as(u32, rgb.r) << 16) | (@as(u32, rgb.g) << 8) | rgb.b;
+}
