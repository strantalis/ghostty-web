+fn applyConfig(wrapper: *BrowserTerminal, config: *const GhosttyTerminalConfig) void {
+    if (config.fg_color != 0) {
+        var fg = rgbCFromU32(config.fg_color);
+        _ = terminal_c.set(wrapper.terminal, .color_foreground, &fg);
+    }
+
+    if (config.bg_color != 0) {
+        var bg = rgbCFromU32(config.bg_color);
+        _ = terminal_c.set(wrapper.terminal, .color_background, &bg);
+    }
+
+    if (config.cursor_color != 0) {
+        var cursor = rgbCFromU32(config.cursor_color);
+        _ = terminal_c.set(wrapper.terminal, .color_cursor, &cursor);
+    }
+
+    var palette = colorpkg.paletteCval(&colorpkg.default);
+    var has_palette_override = false;
+    for (config.palette, 0..) |value, i| {
+        if (value == 0) continue;
+        palette[i] = rgbCFromU32(value);
+        has_palette_override = true;
+    }
+    if (has_palette_override) {
+        _ = terminal_c.set(wrapper.terminal, .color_palette, &palette);
+    }
+}
