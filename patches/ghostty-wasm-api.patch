index 0000000000000000000000000000000000000000..82a0151ca5e6c081235c25ad81f2e6bcf0eeddf9
--- /dev/null
+++ b/src/terminal/c/terminal_wasm.zig
@@ -0,0 +1,1084 @@
+const std = @import("std");
+const assert = std.debug.assert;
+const lib = @import("../lib.zig");
+const CAllocator = lib.alloc.Allocator;
+const colorpkg = @import("../color.zig");
+const page = @import("../page.zig");
+const pointpkg = @import("../point.zig");
+const size = @import("../size.zig");
+const stylepkg = @import("../style.zig");
+const modespkg = @import("../modes.zig");
+const graphics_unicode = @import("../kitty/graphics_unicode.zig");
+const formatter_c = @import("formatter.zig");
+const grid_ref_c = @import("grid_ref.zig");
+const kitty_graphics_c = @import("kitty_graphics.zig");
+const mouse_encode_c = @import("mouse_encode.zig");
+const key_encode_c = @import("key_encode.zig");
+const mouse_event_c = @import("mouse_event.zig");
+const render_c = @import("render.zig");
+const row_c = @import("row.zig");
+const terminal_c = @import("terminal.zig");
+const Result = @import("result.zig").Result;
+
+const DefaultBg: colorpkg.RGB = .{ .r = 0, .g = 0, .b = 0 };
+const DefaultFg: colorpkg.RGB = .{ .r = 204, .g = 204, .b = 204 };
+
+const BrowserTerminal = struct {
+    alloc: std.mem.Allocator,
+    terminal: terminal_c.Terminal,
+    render_state: render_c.RenderState,
+    response_buffer: std.ArrayList(u8) = .empty,
+    title_buffer: std.ArrayList(u8) = .empty,
+    row_dirty: std.ArrayList(u8) = .empty,
+    dirty: render_c.Dirty = .false,
+    title_changed: bool = false,
+    bell_count: u32 = 0,
+    cell_width_px: u32 = 0,
+    cell_height_px: u32 = 0,
+};
+
+pub const GhosttyCell = extern struct {
+    codepoint: u32,
+    fg_r: u8,
+    fg_g: u8,
+    fg_b: u8,
+    bg_r: u8,
+    bg_g: u8,
+    bg_b: u8,
+    flags: u8,
+    width: u8,
+    hyperlink_id: u16,
+    grapheme_len: u8,
+    _pad: u8 = 0,
+};
+
+pub const GhosttyTerminalConfig = extern struct {
+    scrollback_limit: u32,
+    fg_color: u32,
+    bg_color: u32,
+    cursor_color: u32,
+    palette: [16]u32,
+};
+
+const PackedKittyPlacement = extern struct {
+    image_id: u32,
+    placement_id: u32,
+    z: i32,
+    viewport_x: i32,
+    viewport_y: i32,
+    x_offset: i32,
+    y_offset: i32,
+    pixel_width: u32,
+    pixel_height: u32,
+    source_x: u32,
+    source_y: u32,
+    source_width: u32,
+    source_height: u32,
+    image_width: u32,
+    image_height: u32,
+    format: u8,
+    compression: u8,
+    _pad0: [2]u8 = .{ 0, 0 },
+    data_ptr: u32,
+    data_len: u32,
+};
+
+comptime {
+    assert(@sizeOf(GhosttyCell) == 16);
+    assert(@sizeOf(PackedKittyPlacement) == 72);
+}
+
+const CurrentColors = struct {
+    background: colorpkg.RGB,
+    foreground: colorpkg.RGB,
+    cursor: ?colorpkg.RGB,
+    palette: colorpkg.Palette,
+};
+
+pub fn new_simple(cols: c_int, rows: c_int) callconv(lib.calling_conv) ?*anyopaque {
+    return newWithConfig(cols, rows, null);
+}
+
+pub fn newWithConfig(
+    cols: c_int,
+    rows: c_int,
+    config: ?*const GhosttyTerminalConfig,
+) callconv(lib.calling_conv) ?*anyopaque {
+    if (cols <= 0 or rows <= 0) return null;
+
+    const alloc = lib.alloc.default(null);
+    const wrapper = alloc.create(BrowserTerminal) catch return null;
+    errdefer alloc.destroy(wrapper);
+
+    wrapper.* = .{
+        .alloc = alloc,
+        .terminal = null,
+        .render_state = null,
+    };
+
+    if (terminal_c.new(
+        null,
+        &wrapper.terminal,
+        .{
+            .cols = @intCast(cols),
+            .rows = @intCast(rows),
+            .max_scrollback = if (config) |cfg|
+                if (cfg.scrollback_limit == 0) std.math.maxInt(usize) else cfg.scrollback_limit
+            else
+                10_000,
+        },
+    ) != .success) return null;
+    errdefer terminal_c.free(wrapper.terminal);
+
+    if (render_c.new(null, &wrapper.render_state) != .success) return null;
+    errdefer render_c.free(wrapper.render_state);
+
+    _ = terminal_c.set(wrapper.terminal, .userdata, wrapper);
+    _ = terminal_c.set(wrapper.terminal, .write_pty, &writePtyCallback);
+    _ = terminal_c.set(wrapper.terminal, .bell, &bellCallback);
+    _ = terminal_c.set(wrapper.terminal, .title_changed, &titleChangedCallback);
+    _ = terminal_c.mode_set(
+        wrapper.terminal,
+        @bitCast(modespkg.ModeTag{ .value = 2027, .ansi = false }),
+        true,
+    );
+
+    if (config) |cfg| applyConfig(wrapper, cfg);
+
+    return @ptrCast(wrapper);
+}
+
+pub fn free_simple(handle: ?*anyopaque) callconv(lib.calling_conv) void {
+    const wrapper = terminalFromHandle(handle) orelse return;
+    wrapper.response_buffer.deinit(wrapper.alloc);
+    wrapper.title_buffer.deinit(wrapper.alloc);
+    wrapper.row_dirty.deinit(wrapper.alloc);
+    render_c.free(wrapper.render_state);
+    terminal_c.free(wrapper.terminal);
+    wrapper.alloc.destroy(wrapper);
+}
+
+pub fn resize_simple(handle: ?*anyopaque, cols: c_int, rows: c_int) callconv(lib.calling_conv) void {
+    const wrapper = terminalFromHandle(handle) orelse return;
+    _ = terminal_c.resize(
+        wrapper.terminal,
+        @intCast(cols),
+        @intCast(rows),
+        wrapper.cell_width_px,
+        wrapper.cell_height_px,
+    );
+}
+
+pub fn resize_with_cell_size_simple(
+    handle: ?*anyopaque,
+    cols: c_int,
+    rows: c_int,
+    cell_width_px: u32,
+    cell_height_px: u32,
+) callconv(lib.calling_conv) void {
+    const wrapper = terminalFromHandle(handle) orelse return;
+    wrapper.cell_width_px = cell_width_px;
+    wrapper.cell_height_px = cell_height_px;
+    _ = terminal_c.resize(
+        wrapper.terminal,
+        @intCast(cols),
+        @intCast(rows),
+        cell_width_px,
+        cell_height_px,
+    );
+}
+
+pub fn write(handle: ?*anyopaque, ptr: [*]const u8, len: usize) callconv(lib.calling_conv) void {
+    const wrapper = terminalFromHandle(handle) orelse return;
+    terminal_c.vt_write(wrapper.terminal, ptr, len);
+}
+
+pub fn renderStateUpdate(handle: ?*anyopaque) callconv(lib.calling_conv) c_int {
+    const wrapper = terminalFromHandle(handle) orelse return -1;
+    if (render_c.update(wrapper.render_state, wrapper.terminal) != .success) return -1;
+
+    var dirty: render_c.Dirty = .false;
+    if (render_c.get(wrapper.render_state, .dirty, @ptrCast(&dirty)) != .success) return -1;
+    wrapper.dirty = dirty;
+
+    if (snapshotDirtyRows(wrapper) != .success) return -1;
+
+    return switch (dirty) {
+        .false => 0,
+        .partial => 1,
+        .full => 2,
+    };
+}
+
+pub fn renderStateGetCols(handle: ?*anyopaque) callconv(lib.calling_conv) c_int {
+    const wrapper = terminalFromHandle(handle) orelse return 0;
+    var cols: size.CellCountInt = 0;
+    if (terminal_c.get(wrapper.terminal, .cols, @ptrCast(&cols)) != .success) return 0;
+    return cols;
+}
+
+pub fn renderStateGetRows(handle: ?*anyopaque) callconv(lib.calling_conv) c_int {
+    const wrapper = terminalFromHandle(handle) orelse return 0;
+    var rows: size.CellCountInt = 0;
+    if (terminal_c.get(wrapper.terminal, .rows, @ptrCast(&rows)) != .success) return 0;
+    return rows;
+}
+
+pub fn renderStateGetCursorX(handle: ?*anyopaque) callconv(lib.calling_conv) c_int {
+    const wrapper = terminalFromHandle(handle) orelse return 0;
+    var value: size.CellCountInt = 0;
+    if (terminal_c.get(wrapper.terminal, .cursor_x, @ptrCast(&value)) != .success) return 0;
+    return value;
+}
+
+pub fn renderStateGetCursorY(handle: ?*anyopaque) callconv(lib.calling_conv) c_int {
+    const wrapper = terminalFromHandle(handle) orelse return 0;
+    var value: size.CellCountInt = 0;
+    if (terminal_c.get(wrapper.terminal, .cursor_y, @ptrCast(&value)) != .success) return 0;
+    return value;
+}
