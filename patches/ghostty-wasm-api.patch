@@ -233,6 +233,98 @@ GhosttyResult ghostty_terminal_mode_set(GhosttyTerminal terminal,
 
 /** @} */
 
+/* ========================================================================
+ * WASM Extensions - High-performance rendering and extended terminal access
+ * ======================================================================== */
+
+/** @defgroup terminal_wasm Terminal WASM Extensions
+ *
+ * Extended terminal API optimized for WebAssembly usage.
+ * Provides pre-resolved cell data, render state tracking, scrollback access,
+ * hyperlink resolution, and terminal query responses.
+ *
+ * @{
+ */
+
+/** Terminal configuration with color palette. */
+typedef struct {
+    uint32_t scrollback_limit;  /**< Maximum scrollback lines (0 = unlimited) */
+    uint32_t fg_color;          /**< Default foreground color (0xRRGGBB, 0 = default) */
+    uint32_t bg_color;          /**< Default background color (0xRRGGBB, 0 = default) */
+    uint32_t cursor_color;      /**< Cursor color (0xRRGGBB, 0 = default) */
+    uint32_t palette[16];       /**< ANSI color palette (0xRRGGBB, 0 = default) */
+} GhosttyTerminalConfig;
+
+/** Pre-resolved cell structure (16 bytes). */
+typedef struct {
+    uint32_t codepoint;
+    uint8_t fg_r, fg_g, fg_b;
+    uint8_t bg_r, bg_g, bg_b;
+    uint8_t flags;
+    uint8_t width;
+    uint16_t hyperlink_id;
+    uint8_t grapheme_len;
+    uint8_t _pad;
+} GhosttyCell;
+
+#define GHOSTTY_CELL_BOLD          (1 << 0)
+#define GHOSTTY_CELL_ITALIC        (1 << 1)
+#define GHOSTTY_CELL_UNDERLINE     (1 << 2)
+#define GHOSTTY_CELL_STRIKETHROUGH (1 << 3)
+#define GHOSTTY_CELL_INVERSE       (1 << 4)
+#define GHOSTTY_CELL_INVISIBLE     (1 << 5)
+#define GHOSTTY_CELL_BLINK         (1 << 6)
+#define GHOSTTY_CELL_FAINT         (1 << 7)
+
+typedef enum {
+    GHOSTTY_DIRTY_NONE = 0,
+    GHOSTTY_DIRTY_PARTIAL = 1,
+    GHOSTTY_DIRTY_FULL = 2,
+} GhosttyDirty;
+
+/* Simplified lifecycle (WASM-optimized, uses default allocator) */
+void* ghostty_terminal_new_simple(int cols, int rows);
+void* ghostty_terminal_new_with_config(int cols, int rows, const GhosttyTerminalConfig* config);
+void ghostty_terminal_free_simple(void* term);
+void ghostty_terminal_resize_simple(void* term, int cols, int rows);
+void ghostty_terminal_write(void* term, const uint8_t* data, size_t len);
+
+/* RenderState API */
+GhosttyDirty ghostty_render_state_update(void* term);
+int ghostty_render_state_get_cols(void* term);
+int ghostty_render_state_get_rows(void* term);
+int ghostty_render_state_get_cursor_x(void* term);
+int ghostty_render_state_get_cursor_y(void* term);
+bool ghostty_render_state_get_cursor_visible(void* term);
+uint32_t ghostty_render_state_get_bg_color(void* term);
+uint32_t ghostty_render_state_get_fg_color(void* term);
+uint32_t ghostty_render_state_get_cursor_color(void* term);
+bool ghostty_render_state_is_row_dirty(void* term, int y);
+void ghostty_render_state_mark_clean(void* term);
+int ghostty_render_state_get_viewport(void* term, GhosttyCell* buffer, size_t size);
+int ghostty_render_state_get_grapheme(void* term, int row, int col, uint32_t* buffer, size_t size);
+
+/* Terminal mode queries */
+bool ghostty_terminal_is_alternate_screen(void* term);
+bool ghostty_terminal_has_mouse_tracking(void* term);
+bool ghostty_terminal_get_mode(void* term, int mode_num, bool is_ansi);
+
+/* Scrollback API */
+int ghostty_terminal_get_scrollback_length(void* term);
+int ghostty_terminal_get_scrollback_line(void* term, int offset, GhosttyCell* buffer, size_t size);
+int ghostty_terminal_get_scrollback_grapheme(void* term, int offset, int col, uint32_t* buffer, size_t size);
+bool ghostty_terminal_is_row_wrapped(void* term, int y);
+
+/* Hyperlink API */
+int ghostty_terminal_get_hyperlink_uri(void* term, int row, int col, uint8_t* buffer, size_t size);
+int ghostty_terminal_get_scrollback_hyperlink_uri(void* term, int offset, int col, uint8_t* buffer, size_t size);
+
+/* Response API */
+bool ghostty_terminal_has_response(void* term);
+int ghostty_terminal_read_response(void* term, uint8_t* buffer, size_t size);
+
+/** @} */
+
 #ifdef __cplusplus
 }
 #endif
